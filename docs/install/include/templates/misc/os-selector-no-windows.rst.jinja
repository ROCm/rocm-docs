{#
  Template: os-selector-no-windows.rst.jinja
  Renders Linux only OS selector.
  Output: RST with selector directives.

  Primary data: gpus.yaml (passed as `data` by the caller)
  Secondary data: os-support.yaml (loaded via load())

  For each GPU family, GPUs are grouped by their OS fingerprint — the ordered
  set of supported distros (excluding WSL2) plus a WSL2 flag. One
  .. selector:: block is emitted per unique fingerprint.
#}
{%- set os_data = load("/data/os-support.yaml") -%}

{#-- OS display metadata: value, display name, optional toc_label --#}
{%- set os_meta = {
  "Ubuntu":                       {"value": "ubuntu",       "display": "Ubuntu"},
  "Debian":                       {"value": "debian",       "display": "Debian"},
  "Red Hat Enterprise Linux":     {"value": "rhel",         "display": "RHEL",         "toc_label": "Red Hat Enterprise Linux"},
  "Oracle Linux":                 {"value": "oracle-linux", "display": "Oracle Linux"},
  "Rocky Linux":                  {"value": "rocky-linux",  "display": "Rocky Linux"},
  "SUSE Linux Enterprise Server": {"value": "sles",         "display": "SLES",         "toc_label": "SUSE Linux Enterprise Server"},
} -%}

{%- macro slugify(name) -%}
{{- name | lower | replace("+", "") | replace("  ", " ") | replace(" ", "-") -}}
{%- endmacro -%}


{#--
  render_family(family_name, header)
  Emits all .. selector:: blocks for one family.
  GPUs are grouped by OS fingerprint; each group becomes one selector.
--#}
{%- macro render_family(family_name, header) -%}
{%- set family_gpus = data[family_name] -%}
{%- set family_os = os_data[family_name] -%}

{#-- Build per-GPU item list --#}
{%- set gpu_items = [] -%}
{%- for gpu_name in family_gpus.keys() -%}
  {%- if gpu_name in family_os -%}
    {%- set gpu_os = family_os[gpu_name] -%}
    {%- set distros = [] -%}
    {%- for d in gpu_os.keys() if d != "WSL2" and d != "Windows" -%}
      {%- set _ = distros.append(d) -%}
    {%- endfor -%}
    {%- set fp = distros | join("|") -%}
    {%- set _ = gpu_items.append({"name": gpu_name, "fp": fp, "distros": distros}) -%}
  {%- endif -%}
{%- endfor -%}

{#-- Collect unique fingerprints in first-appearance order --#}
{%- set ns = namespace(seen=[]) -%}
{%- set fp_order = [] -%}
{%- for item in gpu_items -%}
  {%- if item.fp not in ns.seen -%}
    {%- set _ = fp_order.append(item.fp) -%}
    {%- set ns.seen = ns.seen + [item.fp] -%}
  {%- endif -%}
{%- endfor -%}

{#-- Render one selector per fingerprint group --#}
{%- for fp in fp_order -%}
{%- set group = gpu_items | selectattr("fp", "equalto", fp) | list -%}
{%- set first = group[0] -%}
{#--
  Fit one row: Bootstrap columns when 12 divides evenly (1, 2, 3, 4, 6, 12
  options), otherwise an equal percentage. The previous hardcoded map fell
  back to "4" for every other count, which wrapped 6-option groups onto two
  rows and shrank single-option groups to a quarter width.
--#}
{%- set n_opts = first.distros | length -%}
{%- set n_opts = n_opts if n_opts > 0 else 1 -%}
{%- if 12 % n_opts == 0 -%}
{%- set w = (12 // n_opts) | string -%}
{%- elif 100 % n_opts == 0 -%}
{%- set w = (100 // n_opts) | string ~ "%" -%}
{%- else -%}
{%- set w = (100.0 / n_opts) | round(4) | string ~ "%" -%}
{%- endif %}

   .. selector:: {{ header }}
      :key: os
      :show-cond: {% for item in group %}gpu={{ slugify(item.name) }} {% endfor %}

{% for distro in first.distros %}
      .. selector-option:: {{ os_meta[distro]["display"] }}
         :value: {{ os_meta[distro]["value"] }}
         :width: {{ w }}
{%- if "toc_label" in os_meta[distro] %}
         :toc-label: {{ os_meta[distro]["toc_label"] }}
{%- endif %}
{% endfor %}
{% endfor -%}
{%- endmacro %}

.. selected:: fam=instinct

{{ render_family("AMD Instinct", "Linux distribution") -}}

.. selected:: fam=radeon

{{ render_family("AMD Radeon", "Operating system") -}}

.. selected:: fam=ryzen

{{ render_family("AMD Ryzen", "Operating system") -}}

.. selected:: fam=all

   .. selector:: Operating system
      :key: os

      .. selector-option:: Ubuntu
         :value: ubuntu
         :width: 4

      .. selector-option:: Debian
         :value: debian
         :width: 4

      .. selector-option:: RHEL
         :value: rhel
         :width: 4
         :toc-label: Red Hat Enterprise Linux

      .. selector-option:: Oracle Linux
         :value: oracle-linux
         :width: 4

      .. selector-option:: Rocky Linux
         :value: rocky-linux
         :width: 4

      .. selector-option:: SLES
         :value: sles
         :width: 4
         :toc-label: SUSE Linux Enterprise Server
